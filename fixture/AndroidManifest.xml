    <application android:label="IG share-sheet fixture"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name="io.github.prabhath112.iggroupguard.fixture.ShareSheetActivity"
            android:configChanges="orientation|screenSize|screenLayout"
            android:exported="true" />
    </application>
</manifest>
