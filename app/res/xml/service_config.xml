<?xml version="1.0" encoding="utf-8"?>
<!-- No packageNames filter on purpose: the service must also see events from the launcher,
     other apps and System UI so it can remove the overlay when Instagram leaves the screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:description="@string/service_desc" />
