<?xml version="1.0" encoding="utf-8"?>
<!-- Events only from Instagram (v2.1). Leaving Instagram is noticed by the service's re-check
     while the banner is shown (RECHECK_MS). Narrower scope is kinder to banking apps that inspect
     enabled accessibility services, though many block any enabled service regardless. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:packageNames="com.instagram.android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:description="@string/service_desc" />
